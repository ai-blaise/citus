# PG version matrix: ai-blaise/citus operand image emits a PG17 and PG18
# variant from the same Dockerfile, gated by PG_MAJOR / BASE_IMAGE build args.
# Operators select a major via Helm `postgresMajor`; default is PG17 for
# stability while PG18 is still alpha (see docs/ai-blaise/NEW_FEATURES.md T6).
build-image-pg17:
	@docker build \
	  -f images/citus-pg-overlay/Dockerfile \
	  --build-arg PG_MAJOR=17 \
	  --build-arg BASE_IMAGE=postgres:17-bookworm \
	  --build-arg AI_BLAISE_SOURCE_GIT_SHA=$$(git rev-parse HEAD) \
	  --build-arg AI_BLAISE_SOURCE_TREE_STATE=$$(test -z "$$(git status --porcelain)" && echo clean || echo dirty) \
	  -t ai-blaise-citus-overlay:pg17 \
	  .

build-image-pg18:
	@docker build \
	  -f images/citus-pg-overlay/Dockerfile \
	  --build-arg PG_MAJOR=18 \
	  --build-arg BASE_IMAGE=postgres:18-bookworm \
	  --build-arg AI_BLAISE_SOURCE_GIT_SHA=$$(git rev-parse HEAD) \
	  --build-arg AI_BLAISE_SOURCE_TREE_STATE=$$(test -z "$$(git status --porcelain)" && echo clean || echo dirty) \
	  -t ai-blaise-citus-overlay:pg18 \
	  .

build-image-bundle1-light-pg17:
	@docker build \
	  -f images/citus-pg-overlay/Dockerfile \
	  --target bundle1-final-light \
	  --build-arg PG_MAJOR=17 \
	  --build-arg BASE_IMAGE=postgres:17-bookworm \
	  --build-arg AI_BLAISE_SOURCE_GIT_SHA=$$(git rev-parse HEAD) \
	  --build-arg AI_BLAISE_SOURCE_TREE_STATE=$$(test -z "$$(git status --porcelain)" && echo clean || echo dirty) \
	  -t ai-blaise-citus-overlay:bundle1-light-pg17 \
	  .

build-image-bundle1-full-pg17:
	@docker build \
	  -f images/citus-pg-overlay/Dockerfile \
	  --target bundle1-final-full \
	  --build-arg PG_MAJOR=17 \
	  --build-arg BASE_IMAGE=postgres:17-bookworm \
	  --build-arg AI_BLAISE_SOURCE_GIT_SHA=$$(git rev-parse HEAD) \
	  --build-arg AI_BLAISE_SOURCE_TREE_STATE=$$(test -z "$$(git status --porcelain)" && echo clean || echo dirty) \
	  -t ai-blaise-citus-overlay:bundle1-full-pg17 \
	  .

build-image-matrix: build-image-pg17 build-image-pg18

features-doc-check:
	@ci/ai-blaise/features-doc-check.sh

slop-scan:
	@ci/ai-blaise/slop-scan.sh

production-readiness-check:
	@ci/ai-blaise/production-readiness-check.sh

production-gap-audit: docs-evidence-boundary-check
	@ci/ai-blaise/production-gap-audit.sh

release-gate-monitor:
	@ci/ai-blaise/release-gate-monitor.sh --local-only

.PHONY: docs-evidence-boundary-check observability-contracts-check release-gate-monitor dr-restore-depth-check
docs-evidence-boundary-check:
	@ci/ai-blaise/docs-evidence-boundary-check.sh

citus-patch-production-audit:
	@ci/ai-blaise/citus-patch-production-audit.sh

runbook-command-check:
	@bash ci/ai-blaise/runbook-command-check.sh

v2-closure-check:
	@bash ci/ai-blaise/v2-closure-check.sh

v2-acceptance-check:
	@bash ci/ai-blaise/v2-acceptance-check.sh

license-check:
	@bash ci/ai-blaise/license-check.sh

# Benchmark harness entry points. Default invocation is quick mode for CI
# smoke (under 60 s). Full nightly/release runs set BENCH_QUICK=0 and longer
# BENCH_DURATION_SECS / BENCH_CLIENTS / BENCH_SCALE.
bench-tpcc:
	@bash benchmarks/tpcc/run.sh

bench-sysbench:
	@bash benchmarks/sysbench/run-suite.sh

bench-timescale-ingest:
	@python3 benchmarks/timescale-ingest/ingest.py --quick

bench-chaos:
	@bash benchmarks/chaos/run.sh

# Aggregate CI smoke for all four harnesses.
bench-router-planner:
	@python3 benchmarks/router-planner/bench.py --quick

router-patch-smoke:
	@bash ci/ai-blaise/router-patch-smoke.sh

bench-smoke:
	@bash ci/ai-blaise/benchmark-smoke.sh

# Per-extension microbench targets. Each invokes the bench.sh in
# benchmarks/microbenches/<ext>/ which soft-passes when psql or the
# target Postgres endpoint is unreachable (quick mode).
microbench-timescaledb:
	@bash benchmarks/microbenches/timescaledb/bench.sh

microbench-citus:
	@bash benchmarks/microbenches/citus/bench.sh

microbench-pgvector:
	@bash benchmarks/microbenches/pgvector/bench.sh

microbench-pg_cron:
	@bash benchmarks/microbenches/pg_cron/bench.sh

microbench-pg_partman:
	@bash benchmarks/microbenches/pg_partman/bench.sh

microbench-pgaudit:
	@bash benchmarks/microbenches/pgaudit/bench.sh

microbench-pgsodium:
	@bash benchmarks/microbenches/pgsodium/bench.sh

microbench-hll:
	@bash benchmarks/microbenches/postgresql-hll/bench.sh

microbench-topn:
	@bash benchmarks/microbenches/postgresql-topn/bench.sh

microbench-tdigest:
	@bash benchmarks/microbenches/tdigest/bench.sh

microbench-pgnodemx:
	@bash benchmarks/microbenches/pgnodemx/bench.sh

microbench-postgis:
	@bash benchmarks/microbenches/postgis/bench.sh

microbench-pg_search:
	@bash benchmarks/microbenches/pg_search/bench.sh

microbench-pg_graphql:
	@bash benchmarks/microbenches/pg_graphql/bench.sh

microbench-pg_jsonschema:
	@bash benchmarks/microbenches/pg_jsonschema/bench.sh

microbench-age:
	@bash benchmarks/microbenches/age/bench.sh

microbench-plrust:
	@bash benchmarks/microbenches/plrust/bench.sh

microbench-plv8:
	@bash benchmarks/microbenches/plv8/bench.sh

microbench-pg_uuidv7:
	@bash benchmarks/microbenches/pg_uuidv7/bench.sh

microbench-pg_repack:
	@bash benchmarks/microbenches/pg_repack/bench.sh

microbench-pg_failover_slots:
	@bash benchmarks/microbenches/pg_failover_slots/bench.sh

microbench-pg_warm:
	@bash benchmarks/microbenches/pg_warm/bench.sh

microbench-pgcrypto:
	@bash benchmarks/microbenches/pgcrypto/bench.sh

microbench-pg_trgm:
	@bash benchmarks/microbenches/pg_trgm/bench.sh

microbench-citext:
	@bash benchmarks/microbenches/citext/bench.sh

microbench-rum:
	@bash benchmarks/microbenches/rum/bench.sh

# Aggregate runner across all 26 microbenches.
microbench-all:
	@bash benchmarks/microbenches/run-all.sh

# Aggregate runner with baseline comparison (fails if any measured run
# regressed > regression_threshold_pct from baseline.json).
microbench-compare:
	@bash benchmarks/microbenches/compare-to-baseline.sh

# CI smoke runner for all 26 microbenches (quick mode).
microbench-smoke:
	@bash ci/ai-blaise/bundled-ext-microbenches-smoke.sh

# Validate benchmark result artifacts against explicit SLO thresholds. The
# default is exploratory so local/PR smoke artifacts may be scaffolded but are
# still parsed and labeled. Use performance-evidence-release-check for releases.
performance-evidence-check:
	@bash ci/ai-blaise/performance-evidence-check.sh $${PERF_EVIDENCE_MODE:-exploratory}

performance-evidence-release-check:
	@PERF_EVIDENCE_MODE=release BENCH_RESULT_TAG=$${BENCH_RESULT_TAG:-release} bash ci/ai-blaise/performance-evidence-check.sh release

performance-evidence-smoke: bench-smoke microbench-smoke
	@PERF_EVIDENCE_MODE=exploratory BENCH_RESULT_TAG=$${BENCH_RESULT_TAG:-quick} bash ci/ai-blaise/performance-evidence-check.sh exploratory

gate-close: export AI_BLAISE_RELEASE_MODE=1
gate-close: export BENCH_REQUIRE_MEASURED=1
gate-close: fdw-credential-rotation-live-smoke
gate-close: schema-drift-live-smoke
