# ai-blaise overlay targets. Upstream Makefile remains untouched.

PATCH_FILES := $(shell find patches -maxdepth 1 -name '*.patch' | sort)

.PHONY: patches-check build-companion test-companion build-operator test-operator build-pool test-pool build-sidecar-shared test-sidecar-shared build-sidecar-vectorizer test-sidecar-vectorizer features-doc-check slop-scan gate-close

patches-check:
	@for patch in $(PATCH_FILES); do \
		echo "checking $$patch"; \
		git apply --check "$$patch"; \
	done

build-companion:
	cargo check -p ai_blaise_citus_companion

test-companion:
	cargo test -p ai_blaise_citus_companion

build-operator:
	cargo check -p ai_blaise_citus_operator

test-operator:
	cargo test -p ai_blaise_citus_operator

build-pool:
	cargo check -p ai_blaise_citus_pool

test-pool:
	cargo test -p ai_blaise_citus_pool

build-sidecar-shared:
	cargo check -p ai_blaise_citus_sidecar_shared

test-sidecar-shared:
	cargo test -p ai_blaise_citus_sidecar_shared

build-sidecar-vectorizer:
	cargo check -p ai_blaise_citus_sidecar_vectorizer

test-sidecar-vectorizer:
	cargo test -p ai_blaise_citus_sidecar_vectorizer

features-doc-check:
	@ci/ai-blaise/features-doc-check.sh

slop-scan:
	@ci/ai-blaise/slop-scan.sh

gate-close: patches-check test-companion test-operator test-pool test-sidecar-shared test-sidecar-vectorizer features-doc-check slop-scan
