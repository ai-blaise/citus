# ai-blaise overlay targets. Upstream Makefile remains untouched.

.PHONY: patches-check build-companion test-companion build-operator test-operator build-pool test-pool build-sidecar-shared test-sidecar-shared build-sidecar-vectorizer test-sidecar-vectorizer build-e2e-model test-e2e-model emit-timescale-apply-plan build-lsp test-lsp analyze-lsp-canonical kind-smoke sql-extension-smoke features-doc-check slop-scan gate-close

patches-check:
	@ci/ai-blaise/patches-check.sh

build-companion:
	cargo check -p ai_blaise_citus_companion

test-companion:
	cargo test -p ai_blaise_citus_companion

build-operator:
	cargo check -p ai_blaise_citus_operator

test-operator:
	cargo test -p ai_blaise_citus_operator

build-pool:
	cargo check -p ai_blaise_citus_pool

test-pool:
	cargo test -p ai_blaise_citus_pool

build-sidecar-shared:
	cargo check -p ai_blaise_citus_sidecar_shared

test-sidecar-shared:
	cargo test -p ai_blaise_citus_sidecar_shared

build-sidecar-vectorizer:
	cargo check -p ai_blaise_citus_sidecar_vectorizer

test-sidecar-vectorizer:
	cargo test -p ai_blaise_citus_sidecar_vectorizer

build-e2e-model:
	cargo check -p ai_blaise_citus_e2e

test-e2e-model:
	cargo test -p ai_blaise_citus_e2e

emit-timescale-apply-plan:
	cargo run -p ai_blaise_citus_e2e --bin timescale_apply_plan

build-lsp:
	cargo check -p ai_blaise_citus_lsp --all-targets

test-lsp:
	cargo test -p ai_blaise_citus_lsp

analyze-lsp-canonical:
	cargo run -p ai_blaise_citus_lsp -- analyze-canonical

kind-smoke:
	@tests/e2e/kind-timescale-citus-smoke.sh

sql-extension-smoke:
	@ci/ai-blaise/sql-extension-smoke.sh

features-doc-check:
	@ci/ai-blaise/features-doc-check.sh

slop-scan:
	@ci/ai-blaise/slop-scan.sh

gate-close: patches-check test-companion test-operator test-pool test-sidecar-shared test-sidecar-vectorizer test-e2e-model test-lsp features-doc-check slop-scan sql-extension-smoke
